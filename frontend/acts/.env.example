# Base URL of bare-acts-service (FastAPI). No trailing slash.
BARE_ACTS_API_URL=http://localhost:8096

# Sent as the X-API-Key header on every server-side call (never exposed to the browser).
BARE_ACTS_API_KEY=

# Shared secret for POST /acts/api/revalidate. Must equal the backend's NEXT_REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Public origin of the site, no trailing slash. Used for canonical URLs, the sitemap and JSON-LD.
SITE_URL=https://jurinex.ai

# Optional, not a secret: auth service used by the footer newsletter form (same as the React
# app's VITE_APP_AUTH_SERVICE_URL). Defaults to localhost:5001 locally and the Cloud Run URL otherwise.
# NEXT_PUBLIC_AUTH_SERVICE_URL=
